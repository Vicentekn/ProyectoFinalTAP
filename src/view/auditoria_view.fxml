<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="660.0" prefWidth="1050.0" style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AuditoriaController">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <children>
                <VBox>
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"
                               text="Módulo de Auditoría y Reportes Financieros (CU-06)" />
                        <Label fx:id="lblAuditorActivo" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;"
                               text="Auditor: Sin sesión" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#handleCerrarSesion"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"
                        text="Cerrar Sesión" />
            </children>
        </HBox>
    </top>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- PANEL DE FILTROS -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #dcdde1; -fx-border-radius: 6;">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Desde:" />
                        <DatePicker fx:id="dpFechaInicio" prefWidth="140.0" />

                        <Label style="-fx-font-weight: bold;" text="Hasta:" />
                        <DatePicker fx:id="dpFechaFin" prefWidth="140.0" />

                        <Label style="-fx-font-weight: bold;" text="Estado:" />
                        <ComboBox fx:id="cmbEstadoFiltro" prefWidth="175.0" />

                        <Button onAction="#handleConsultarReporte"
                                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 15; -fx-cursor: hand;"
                                text="Generar Consulta" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button onAction="#handleExportarCSV"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 15; -fx-cursor: hand;"
                                text="Exportar Reporte CSV" />
                    </children>
                </HBox>

                <!-- TARJETAS DE RESUMEN FINANCIERO (KPIs) -->
                <HBox spacing="15.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #27ae60; -fx-border-width: 0 0 0 4;">
                            <children>
                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;" text="INGRESOS RECAUDADOS EN EL PERIODO" />
                                <Label fx:id="lblIngresosTotales" style="-fx-text-fill: #27ae60; -fx-font-size: 24px; -fx-font-weight: bold;" text="\$0.00 MXN" />
                            </children>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #2980b9; -fx-border-width: 0 0 0 4;">
                            <children>
                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;" text="TICKETS LIQUIDADOS (PAGADOS)" />
                                <Label fx:id="lblTotalPagados" style="-fx-text-fill: #2980b9; -fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                            </children>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #f39c12; -fx-border-width: 0 0 0 4;">
                            <children>
                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;" text="TOTAL DE REGISTROS EN CONSULTA" />
                                <Label fx:id="lblTotalRegistros" style="-fx-text-fill: #f39c12; -fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- TABLA DE AUDITORÍA -->
                <TableView fx:id="tblAuditoria" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFolio" prefWidth="150.0" text="Folio" />
                        <TableColumn fx:id="colPlaca" prefWidth="100.0" text="Placa" />
                        <TableColumn fx:id="colTipo" prefWidth="110.0" text="Vehículo" />
                        <TableColumn fx:id="colCajon" prefWidth="70.0" text="Cajón" />
                        <TableColumn fx:id="colIngreso" prefWidth="150.0" text="Fecha Ingreso" />
                        <TableColumn fx:id="colSalida" prefWidth="150.0" text="Fecha Salida" />
                        <TableColumn fx:id="colMonto" prefWidth="105.0" text="Monto ($)" />
                        <TableColumn fx:id="colEstado" prefWidth="135.0" text="Estado" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>

    <!-- BARRA INFERIOR -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 8 15; -fx-border-color: #bdc3c7; -fx-border-width: 1 0 0 0;">
            <children>
                <Label fx:id="lblEstado" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Listo para auditar." />
            </children>
        </HBox>
    </bottom>
</BorderPane>