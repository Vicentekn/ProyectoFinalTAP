<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="980.0" style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.CasetaController">

    <!-- BARRA SUPERIOR: Título, Operador activo y Panel de Ocupación en Vivo (CU-07) -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <children>
                <VBox>
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"
                               text="Control de Caseta y Accesos" />
                        <Label fx:id="lblOperadorActivo" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;"
                               text="Operador: Sin sesión" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Indicador de Ocupación en Tiempo Real -->
                <HBox alignment="CENTER" spacing="15.0"
                      style="-fx-background-color: #34495e; -fx-padding: 10 20; -fx-background-radius: 6;">
                    <children>
                        <VBox alignment="CENTER">
                            <children>
                                <Label style="-fx-text-fill: #ecf0f1; -fx-font-size: 11px;" text="DISPONIBLES" />
                                <Label fx:id="lblDisponibles"
                                       style="-fx-text-fill: #2ecc71; -fx-font-size: 20px; -fx-font-weight: bold;"
                                       text="50" />
                            </children>
                        </VBox>
                        <Separator orientation="VERTICAL" />
                        <VBox alignment="CENTER">
                            <children>
                                <Label style="-fx-text-fill: #ecf0f1; -fx-font-size: 11px;" text="OCUPADOS" />
                                <Label fx:id="lblOcupados"
                                       style="-fx-text-fill: #e74c3c; -fx-font-size: 20px; -fx-font-weight: bold;"
                                       text="0" />
                            </children>
                        </VBox>
                        <Separator orientation="VERTICAL" />
                        <VBox alignment="CENTER">
                            <children>
                                <Label style="-fx-text-fill: #ecf0f1; -fx-font-size: 11px;" text="OCUPACIÓN" />
                                <Label fx:id="lblPorcentaje"
                                       style="-fx-text-fill: #f1c40f; -fx-font-size: 20px; -fx-font-weight: bold;"
                                       text="0%" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Button onAction="#handleCerrarSesion"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"
                        text="Cerrar Sesión" />
            </children>
        </HBox>
    </top>

    <!-- PANEL IZQUIERDO: Formularios de Entrada (CU-01) y Salida/Cobro (CU-02/03) -->
    <left>
        <VBox prefWidth="310.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- SECCIÓN 1: REGISTRAR ENTRADA -->
                <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #e1e4e8; -fx-border-radius: 6;">
                    <children>
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"
                               text="1. Registrar Entrada (CU-01)" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Placa del Vehículo:" />
                        <TextField fx:id="txtPlacaEntrada" promptText="Ej. ABC-123-D" style="-fx-pref-height: 35px;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Tipo de Vehículo:" />
                        <ComboBox fx:id="cmbTipoVehiculo" maxWidth="Infinity" style="-fx-pref-height: 35px;" />

                        <Button fx:id="btnRegistrarEntrada" maxWidth="Infinity" onAction="#handleRegistrarEntrada"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40px; -fx-cursor: hand;"
                                text="Registrar Entrada y Ticket" />
                    </children>
                </VBox>

                <!-- SECCIÓN 2: REGISTRAR SALIDA Y COBRO (Preparado para Día 11) -->
                <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #e1e4e8; -fx-border-radius: 6;">
                    <children>
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #d35400;"
                               text="2. Salida y Cobro (CU-02/03)" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Folio o Placa a Cobrar:" />
                        <TextField fx:id="txtFolioSalida" promptText="Seleccione de la tabla o escriba"
                                   style="-fx-pref-height: 35px;" />

                        <CheckBox fx:id="chkBoletoPerdido" text="Aplicar cargo por Boleto Perdido"
                                  style="-fx-text-fill: #c0392b; -fx-font-weight: bold;" />

                        <Button fx:id="btnProcesarSalida" maxWidth="Infinity" onAction="#handleProcesarSalida"
                                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40px; -fx-cursor: hand;"
                                text="Calcular y Cobrar Salida" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- CENTRO: Tabla de Vehículos Actualmente Dentro del Estacionamiento -->
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                               text="Vehículos Activos en el Estacionamiento" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#actualizarDatos"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"
                                text="Actualizar Tabla" />
                    </children>
                </HBox>

                <TableView fx:id="tblTicketsActivos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFolio" prefWidth="155.0" text="Folio Ticket" />
                        <TableColumn fx:id="colPlaca" prefWidth="110.0" text="Placa" />
                        <TableColumn fx:id="colTipo" prefWidth="115.0" text="Tipo Vehículo" />
                        <TableColumn fx:id="colCajon" prefWidth="80.0" text="Cajón #" />
                        <TableColumn fx:id="colIngreso" prefWidth="165.0" text="Fecha / Hora Ingreso" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>

    <!-- BARRA INFERIOR: Mensajes de Estado -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 8 15; -fx-border-color: #bdc3c7; -fx-border-width: 1 0 0 0;">
            <children>
                <Label fx:id="lblEstado" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"
                       text="Sistema listo." />
            </children>
        </HBox>
    </bottom>
</BorderPane>