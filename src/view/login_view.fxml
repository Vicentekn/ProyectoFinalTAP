<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="380.0" spacing="15.0"
      style="-fx-background-color: #f4f6f9;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LoginController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <children>
        <!-- Encabezado del Sistema -->
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
               text="Control de Estacionamiento" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"
               text="Inicie sesión para continuar" />

        <!-- Campo de Usuario -->
        <VBox spacing="5.0">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Usuario:" />
                <TextField fx:id="txtUsername" promptText="Ingrese su usuario (ej. admin)"
                           style="-fx-pref-height: 35px;" />
            </children>
        </VBox>

        <!-- Campo de Contraseña -->
        <VBox spacing="5.0">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Contraseña:" />
                <PasswordField fx:id="txtPassword" onAction="#handleLogin"
                               promptText="Ingrese su contraseña"
                               style="-fx-pref-height: 35px;" />
            </children>
        </VBox>

        <!-- Etiqueta para mensajes de error o estado -->
        <Label fx:id="lblMensajeError" alignment="CENTER" textAlignment="CENTER" wrapText="true"
               style="-fx-text-fill: #e74c3c; -fx-font-size: 12px; -fx-font-weight: bold;" />

        <!-- Botón de Acceso -->
        <Button fx:id="btnIngresar" defaultButton="true" maxWidth="Infinity"
                onAction="#handleLogin"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 38px; -fx-cursor: hand;"
                text="Iniciar Sesión" />
    </children>
</VBox>